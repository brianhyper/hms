        <addForeignKeyConstraint baseColumnNames="to_bed_id"
                                 baseTableName="admission_transfer"
                                 constraintName="fk_admission_transfer__to_bed_id"
                                 referencedColumnNames="id"
                                 referencedTableName="bed"
                                 />

        <addForeignKeyConstraint baseColumnNames="transferred_by_id"
                                 baseTableName="admission_transfer"
                                 constraintName="fk_admission_transfer__transferred_by_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"
                                 />
    </changeSet>
</databaseChangeLog>
