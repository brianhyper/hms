    <!--
        Added the constraints for entity DoctorOrder.
    -->
    <changeSet id="20260925124309-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="admission_id"
                                 baseTableName="doctor_order"
                                 constraintName="fk_doctor_order__admission_id"
                                 referencedColumnNames="id"
