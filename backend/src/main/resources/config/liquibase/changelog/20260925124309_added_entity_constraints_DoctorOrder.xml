                                 />

        <addForeignKeyConstraint baseColumnNames="cancelled_by_id"
                                 baseTableName="doctor_order"
                                 constraintName="fk_doctor_order__cancelled_by_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"
                                 />
    </changeSet>
</databaseChangeLog>
